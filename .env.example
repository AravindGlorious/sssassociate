# ---- Site ----
# Production URL: used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://sss-associate.vercel.app

# ---- Enquiry form email (Resend, https://resend.com) ----
# REQUIRED for emails to be delivered. Without it the form shows a clear
# "could not send by email" message plus a one-tap WhatsApp/call fallback. It never fakes success.
RESEND_API_KEY=

# Optional. Defaults to sssassociateservices@gmail.com (the business email).
CONTACT_TO_EMAIL=sssassociateservices@gmail.com

# Optional. Defaults to "SSS Associate Website <onboarding@resend.dev>", Resend's test sender,
# which can only deliver to the email address that owns the Resend account.
# For production, verify your own domain in Resend and set e.g. "SSS Associate <enquiries@your-domain>".
CONTACT_FROM_EMAIL=

# ---- Google Search Console (optional) ----
# Paste ONLY the content value of the Google "HTML tag" verification method. Needs a redeploy.
GOOGLE_SITE_VERIFICATION=
